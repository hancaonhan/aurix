# =============================================================================
# AURIX — cấu hình môi trường
#
# Chép tệp này thành `.env` ở gốc dự án rồi điền giá trị thật.
# `.env` KHÔNG được đưa lên git (đã có trong .gitignore).
#
# Sinh chuỗi bí mật:  node server/cli.js secret
# Kiểm tra cấu hình:  node server/cli.js doctor
# =============================================================================

# ---------- Máy chủ ----------
NODE_ENV=production
PORT=4477
# Địa chỉ BIND, không phải tên miền. Đặt 0.0.0.0 khi chạy trong container
# (Vibe Host, Docker) để proxy bên ngoài vào được; đặt 127.0.0.1 khi chạy trên
# VPS có nginx cùng máy, để Node không phơi ra Internet.
HOST=0.0.0.0
# Tên miền thật, dùng cho canonical, sitemap, JSON-LD và kiểm tra CSRF
AURIX_ORIGIN=https://aurixvietnam.vn
# Số lớp reverse proxy phía trước (nginx = 1; nginx sau Cloudflare = 2).
# Đặt 0 nếu Node nhận kết nối trực tiếp — khai sai sẽ khiến giới hạn tần suất
# bị vô hiệu vì ai cũng giả được IP qua header x-forwarded-for.
AURIX_TRUST_PROXY=1

# ---------- Bảo mật (BẮT BUỘC ở môi trường thật) ----------
# Ký cookie phiên. Đổi giá trị này = đăng xuất toàn bộ người dùng.
AURIX_SESSION_SECRET=
# Muối băm IP. Phải cố định, nếu không giới hạn tần suất sẽ reset mỗi lần deploy.
AURIX_IP_SALT=
# Thời gian sống của phiên (giây). 43200 = 12 giờ.
AURIX_SESSION_TTL=43200
AURIX_MAX_LOGIN_ATTEMPTS=5
AURIX_LOCKOUT_SECONDS=900
AURIX_SECURE_COOKIES=true
# Origin khác miền được phép gọi API (ngăn cách bằng dấu phẩy). Để trống nếu
# chỉ phục vụ chính website này — đây là lựa chọn an toàn nhất.
AURIX_CORS_ORIGINS=
# Khoá cho tích hợp máy-với-máy (CRM đồng bộ khách tiềm năng). Nhiều khoá ngăn
# cách bằng dấu phẩy. Sinh bằng: node server/cli.js secret
AURIX_API_KEYS=

# ---------- Cơ sở dữ liệu (PostgreSQL 16) ----------
# Chuỗi kết nối. Trên Vibe Host biến này được TIÊM TỰ ĐỘNG khi đã gắn cơ sở dữ
# liệu vào website — không cần khai. Chỉ khai ở máy phát triển.
#
# Máy phát triển nên trỏ vào một database RIÊNG, không dùng chung với website
# thật: chạy thử ở máy sẽ ghi thẳng vào dữ liệu khách hàng.
DATABASE_URL=postgresql://nguoidung:matkhau@may-chu:5432/aurix_dev

# Bật TLS khi nối tới cơ sở dữ liệu. Mặc định TẮT vì endpoint PostgreSQL của
# Vibe Host không hỗ trợ TLS; bật lên sẽ nhận "The server does not support SSL
# connections" và máy chủ không khởi động được. Đổi sang nhà cung cấp có TLS
# (Neon, Supabase, RDS…) thì đặt true.
AURIX_DB_SSL=false

# Số kết nối tối đa trong pool. Instance Vibe Host giới hạn 100 cho tất cả.
AURIX_DB_POOL=10

# Nơi đặt tệp kết xuất của lệnh `node server/cli.js backup`.
#
# Phải trỏ vào một thư mục đã khai ở tab "Thư mục dữ liệu bền" của Vibe Host,
# nếu không bản sao lưu bị xoá cùng container ở lần triển khai kế tiếp — đúng
# lúc cần đến nó nhất. Trên VPS thì dùng đường dẫn thường, ví dụ /var/backups.
#
# ĐỪNG để trống dòng này: auto-config của Vibe Host coi mọi biến có mặt trong
# tệp mà không có giá trị là BẮT BUỘC, và sẽ chặn triển khai.
AURIX_BACKUP_DIR=/app/data/backups

# ---------- Thư (SMTP) ----------
# Bỏ trống toàn bộ = chế độ nháp: thư vẫn vào hàng đợi và ghi ra nhật ký,
# không có dữ liệu nào bị mất, chỉ là không gửi đi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
AURIX_MAIL_FROM=Aurix <no-reply@aurixvietnam.vn>
AURIX_SALES_INBOX=admin@aurixvietnam.vn

# ---------- Nhật ký ----------
AURIX_LOG_LEVEL=info
# JSON một dòng — hợp với journald và các trình thu thập log trên hosting
AURIX_LOG_JSON=true
AURIX_LOG_SLOW_MS=120

# ---------- Giới hạn tần suất ----------
RL_LEAD_MAX=5
RL_LEAD_WINDOW=600000
RL_DX_MAX=20
RL_DX_WINDOW=60000
RL_LOGIN_MAX=10
RL_LOGIN_WINDOW=600000
RL_API_MAX=120
RL_API_WINDOW=60000
