# =============================================================================
# AURIX — cấu hình môi trường
#
# Chép tệp này thành `.env` ở gốc dự án rồi điền giá trị thật.
# `.env` KHÔNG được đưa lên git (đã có trong .gitignore).
#
# Sinh chuỗi bí mật:  node server/cli.js secret
# Kiểm tra cấu hình:  node server/cli.js doctor
# =============================================================================

# ---------- Máy chủ ----------
NODE_ENV=production
PORT=4477
HOST=127.0.0.1
# Tên miền thật, dùng cho canonical, sitemap, JSON-LD và kiểm tra CSRF
AURIX_ORIGIN=https://aurixvietnam.vn
# Số lớp reverse proxy phía trước (nginx = 1; nginx sau Cloudflare = 2).
# Đặt 0 nếu Node nhận kết nối trực tiếp — khai sai sẽ khiến giới hạn tần suất
# bị vô hiệu vì ai cũng giả được IP qua header x-forwarded-for.
AURIX_TRUST_PROXY=1

# ---------- Bảo mật (BẮT BUỘC ở môi trường thật) ----------
# Ký cookie phiên. Đổi giá trị này = đăng xuất toàn bộ người dùng.
AURIX_SESSION_SECRET=
# Muối băm IP. Phải cố định, nếu không giới hạn tần suất sẽ reset mỗi lần deploy.
AURIX_IP_SALT=
# Thời gian sống của phiên (giây). 43200 = 12 giờ.
AURIX_SESSION_TTL=43200
AURIX_MAX_LOGIN_ATTEMPTS=5
AURIX_LOCKOUT_SECONDS=900
AURIX_SECURE_COOKIES=true
# Origin khác miền được phép gọi API (ngăn cách bằng dấu phẩy). Để trống nếu
# chỉ phục vụ chính website này — đây là lựa chọn an toàn nhất.
AURIX_CORS_ORIGINS=
# Khoá cho tích hợp máy-với-máy (CRM đồng bộ khách tiềm năng). Nhiều khoá ngăn
# cách bằng dấu phẩy. Sinh bằng: node server/cli.js secret
AURIX_API_KEYS=

# ---------- Cơ sở dữ liệu ----------
AURIX_DB=/var/www/aurix/server/data/aurix.db
AURIX_BACKUP_DIR=/var/backups/aurix

# ---------- Thư (SMTP) ----------
# Bỏ trống toàn bộ = chế độ nháp: thư vẫn vào hàng đợi và ghi ra nhật ký,
# không có dữ liệu nào bị mất, chỉ là không gửi đi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
AURIX_MAIL_FROM=Aurix <no-reply@aurixvietnam.vn>
AURIX_SALES_INBOX=admin@aurixvietnam.vn

# ---------- Nhật ký ----------
AURIX_LOG_LEVEL=info
# JSON một dòng — hợp với journald và các trình thu thập log trên hosting
AURIX_LOG_JSON=true
AURIX_LOG_SLOW_MS=120

# ---------- Giới hạn tần suất ----------
RL_LEAD_MAX=5
RL_LEAD_WINDOW=600000
RL_DX_MAX=20
RL_DX_WINDOW=60000
RL_LOGIN_MAX=10
RL_LOGIN_WINDOW=600000
RL_API_MAX=120
RL_API_WINDOW=60000
